{
  "name": "agent-status",
  "version": "1.0.5",
  "description": "Local floating status indicators for Claude Code and Codex CLI",
  "author": "Agent Status",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "prepare": "husky",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/copy-assets.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "dist": "npm run build && electron-builder --win portable --x64 && node scripts/package-files.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.70.0"
  },
  "build": {
    "appId": "local.agentstatus.app",
    "productName": "Agent Status",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/tests/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "integration",
        "to": "integration"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png",
      "executableName": "AgentStatus"
    },
    "portable": {
      "artifactName": "AgentStatus.exe"
    }
  }
}
